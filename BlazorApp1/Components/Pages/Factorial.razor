@page "/Factorial"
@rendermode InteractiveServer

<h3>factorial</h3>

<div class="factorial">
    <div>
    <label for="number">Число для вычисления Факториала</label>
    <input type="number" id="number" @bind="number" @bind:after="Calculate"/>
    <button @onclick="Calculate">Вычислить</button>
    </div>
    <div id="factorial-result">@number != @factorial</div>
</div>


@page "/Factorial"
@rendermode InteractiveServer
<h3>factorial</h3>

<div class="factorial">
    <div>
    <label for="number">Число для вычисления Факториала</label>
    <input type="number" id="number" @bind="number"/>
    <button @onclick="Calculate">Вычислить</button>
    </div>
    <div id="factorial-result">@number != @factorial</div>
</div>

@code {
    int number = 0;
    int factorial = 1;

    void Calculate()
    {
        factorial = 1;
        for (int i = 1; i <= number; i++)
        {
            factorial *= i;
        }
    }
}